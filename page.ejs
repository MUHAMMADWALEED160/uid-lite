    <tbody>
      <% claims.forEach(function(c){ %>
        <tr>
          <td>
            <% if (c.item) { %>
              <a href="/items/<%= c.item._id %>"><%= c.item.title %></a>
              <div><span class="badge bg-<%= statusClass(c.item.status) %> text-capitalize"><%= c.item.status %></span></div>
            <% } else { %>(deleted)<% } %>
          </td>
          <td>
            <%= c.claimedBy ? c.claimedBy.name : "-" %>
            <% if (c.claimedBy) { %><div class="small text-muted"><%= c.claimedBy.email %> &middot; <%= c.claimedBy.department %></div><% } %>
          </td>
          <td style="max-width:320px; white-space: pre-line;"><%= c.message %></td>
          <td><%= fmtDate(c.createdAt) %></td>
          <td><span class="badge bg-<%= c.status === "approved" ? "success" : c.status === "rejected" ? "danger" : "warning text-dark" %> text-capitalize"><%= c.status %></span></td>
          <td class="text-end text-nowrap">
            <% if (c.status === "pending") { %>
              <form method="POST" action="/admin/claims/<%= c._id %>/approve" class="d-inline"
                    onsubmit="return confirm(&#39;Approve this claim? The item will be marked as Claimed.&#39;);">
