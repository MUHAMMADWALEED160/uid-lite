<%#
  ONE template for the whole website. server.js sets "pageView" (e.g. "notices/list"),
  and only that section below is shown. Search with Ctrl+F for:  PAGE: <name>
  Layout order:  [display page]  OR  [top navbar] + [PAGE sections] + [footer]
%>
<% if (pageView === "display") { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Display Mode | University Information Display System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
/* Display Mode: full-screen dark layout for campus TVs (matches the academic theme) */
/* The ampersand in Playfair Display is very ornate, so "&" is drawn with a plain system font instead */
@font-face {
  font-family: "UidsAmp";
  font-weight: 100 900;
  unicode-range: U+0026;
  src: local("Arial Bold"), local("Arial-BoldMT"), local("Segoe UI Bold"), local("SegoeUI-Bold"),
       local("Helvetica Neue Bold"), local("HelveticaNeue-Bold"), local("Roboto Bold"), local("Roboto-Bold"),
       local("Arial"), local("Segoe UI"), local("Helvetica"), local("Roboto");
}

:root {
  --bg1: #170d2b;
  --bg2: #35205f;
  --text: #f4f7fb;
  --muted: #a9b8d0;
  --urgent: #e63946;
  --notice: #c9a227;
  --gold: #c9a227;
  --found: #22c55e;
}

* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }

body {
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, var(--bg1), var(--bg2));
  color: var(--text);
  font-family: "Source Sans 3", "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
  overflow: hidden;
}
body.idle { cursor: none; }

/* ---- Top bar ---- */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 1.2vh 3vw;
  background: rgba(0, 0, 0, 0.25);
  border-bottom: 2px solid rgba(201, 162, 39, 0.55);
}
.brand { font-family: "UidsAmp", "Playfair Display", Georgia, serif; font-size: clamp(1rem, 2.2vw, 2.4rem); font-weight: 700; letter-spacing: 0.03em; }
.clockbox { text-align: right; line-height: 1.15; }
#clock { font-size: clamp(1.4rem, 3.4vw, 3.8rem); font-weight: 700; font-variant-numeric: tabular-nums; }
#date { font-size: clamp(0.8rem, 1.5vw, 1.7rem); color: var(--muted); }

/* ---- Stage ---- */
.stage { position: relative; flex: 1; min-height: 0; display: flex; }

.slide {
  flex: 1;
  min-width: 0;
  padding: 4vh 5vw 6vh;
  display: flex;
  opacity: 0;
  transform: translateY(12px);
  transition: opacity 0.35s ease, transform 0.35s ease;
}
.slide.show { opacity: 1; transform: none; }

.loading { margin: auto; font-size: clamp(1.4rem, 3vw, 3rem); color: var(--muted); text-align: center; }

.slide-inner {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 4vw;
  min-width: 0;
  padding-left: 2.5vw;
  border-left: 0.8vw solid var(--notice);
}
.slide-inner.kind-urgent { border-left-color: var(--urgent); }
.slide-inner.kind-found { border-left-color: var(--found); }
.slide-inner.kind-empty { border-left-color: var(--muted); }

.slide-text { flex: 1; min-width: 0; }
.slide-image { flex: 0 0 38%; max-height: 100%; display: flex; align-items: center; justify-content: center; }
.slide-image img {
  max-width: 100%;
  max-height: 58vh;
  border-radius: 1.2vw;
  box-shadow: 0 1vh 4vh rgba(0, 0, 0, 0.5);
  object-fit: contain;
  background: rgba(255, 255, 255, 0.05);
}

.badges { display: flex; flex-wrap: wrap; gap: 0.8vw; margin-bottom: 2vh; }
.badge {
  display: inline-block;
  padding: 0.5vh 1.2vw;
  border-radius: 999px;
  font-size: clamp(0.8rem, 1.5vw, 1.7rem);
  font-weight: 700;
  letter-spacing: 0.08em;
  background: rgba(255, 255, 255, 0.14);
}
.badge-urgent { background: var(--urgent); animation: pulse 1.4s ease-in-out infinite; }
.badge-notice { background: var(--notice); color: #241a00; }
.badge-found { background: var(--found); color: #04210f; }

.title {
  font-family: "UidsAmp", "Playfair Display", Georgia, serif;
  margin: 0 0 2vh;
  font-size: clamp(1.8rem, 4.6vw, 5.2rem);
  line-height: 1.1;
  overflow-wrap: anywhere;
}
.desc {
  margin: 0 0 3vh;
  font-size: clamp(1.05rem, 2vw, 2.3rem);
  line-height: 1.4;
  color: #dbe4f3;
  overflow-wrap: anywhere;
  white-space: pre-line;
}
.facts { display: flex; flex-wrap: wrap; gap: 0.5vh 2.5vw; color: var(--muted); font-size: clamp(0.95rem, 1.6vw, 1.9rem); }
.hint { margin-top: 2.5vh; font-size: clamp(0.9rem, 1.5vw, 1.8rem); color: var(--found); }

.counter {
  position: absolute;
  right: 3vw;
  bottom: 1.6vh;
  font-size: clamp(0.8rem, 1.2vw, 1.4rem);
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}
.progress { position: absolute; left: 0; right: 0; bottom: 0; height: 0.7vh; background: rgba(255, 255, 255, 0.08); }
#progressBar { width: 0; height: 100%; background: linear-gradient(90deg, var(--gold), #f3d36b); }

/* ---- Ticker ---- */
.ticker {
  display: flex;
  align-items: stretch;
  background: rgba(0, 0, 0, 0.45);
  border-top: 2px solid rgba(255, 255, 255, 0.1);
  font-size: clamp(1rem, 2vw, 2.3rem);
}
.ticker-label {
  flex: 0 0 auto;
  padding: 1.4vh 2vw;
  background: var(--gold);
  color: #241a00;
  font-weight: 800;
  letter-spacing: 0.1em;
}
.ticker-window { flex: 1; overflow: hidden; display: flex; align-items: center; }
.ticker-track { display: flex; width: max-content; will-change: transform; }
.ticker-chunk { display: flex; white-space: nowrap; }
.ticker-item { padding: 1.4vh 3vw 1.4vh 0; }
.ticker-item.urgent { color: #ff8a93; font-weight: 700; }

/* ---- Fullscreen button ---- */
.fs-btn {
  position: fixed;
  top: 1vh;
  left: 1vw;
  width: 2.6rem;
  height: 2.6rem;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  color: var(--text);
  font-size: 1.3rem;
  cursor: pointer;
  opacity: 0.6;
  transition: opacity 0.3s;
}
.fs-btn:hover { opacity: 1; }
body.idle .fs-btn { opacity: 0; }

@keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.07); } }

/* Chhoti screen (phone par test) */
@media (max-width: 700px) {
  .slide-inner { flex-direction: column; align-items: flex-start; gap: 2vh; }
  .slide-image { flex: none; width: 100%; }
}
</style>
</head>
<body data-interval="<%= interval %>">
  <header class="topbar">
    <div class="brand">🎓 <span>University Information Display System</span></div>
    <div class="clockbox">
      <div id="clock">--:--:--</div>
      <div id="date">&nbsp;</div>
    </div>
  </header>

  <main class="stage">
    <section id="slide" class="slide show"><div class="loading">Loading…</div></section>
    <div class="counter" id="counter"></div>
    <div class="progress"><div id="progressBar"></div></div>
  </main>

  <footer class="ticker">
    <div class="ticker-label">LATEST</div>
    <div class="ticker-window" id="tickerWindow"><div id="tickerTrack" class="ticker-track"></div></div>
  </footer>

  <button id="fsBtn" class="fs-btn" title="Fullscreen (F)">⛶</button>
  <script>
// Display Mode: slides auto-rotate, live clock, news ticker (vanilla JS + Fetch API)
(function () {
  var INTERVAL = (parseInt(document.body.getAttribute("data-interval"), 10) || 8) * 1000;
  var REFRESH = 60 * 1000; // data is reloaded every minute

  var slideEl = document.getElementById("slide");
  var counterEl = document.getElementById("counter");
  var barEl = document.getElementById("progressBar");
  var trackEl = document.getElementById("tickerTrack");
  var windowEl = document.getElementById("tickerWindow");
  var clockEl = document.getElementById("clock");
  var dateEl = document.getElementById("date");

  var slides = [];
  var idx = -1;
  var timer = null;
  var started = false;
  var token = 0;

  // Always use textContent so database text is never interpreted as HTML
  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  function fmtDate(iso) {
    return iso
      ? new Date(iso).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
      : "";
  }

  // ---------- Clock ----------
  function tick() {
    var now = new Date();
    clockEl.textContent = now.toLocaleTimeString("en-US", {
      hour: "2-digit", minute: "2-digit", second: "2-digit"
    });
    dateEl.textContent = now.toLocaleDateString("en-GB", {
      weekday: "long", day: "numeric", month: "long", year: "numeric"
    });
  }

  // ---------- Slides ----------
  function buildSlides(d) {
    var out = [];
    (d.urgent || []).forEach(function (n) { out.push({ kind: "urgent", n: n }); });
    (d.latest || []).forEach(function (n) { out.push({ kind: "notice", n: n }); });
    (d.found || []).forEach(function (n) { out.push({ kind: "found", n: n }); });
    if (!out.length) out.push({ kind: "empty" });
    return out;
  }

  function slideContent(s) {
    var wrap = el("div", "slide-inner kind-" + s.kind);
    var text = el("div", "slide-text");

    if (s.kind === "empty") {
      text.appendChild(el("div", "badges")).appendChild(el("span", "badge badge-notice", "WELCOME"));
      text.appendChild(el("h1", "title", "Welcome to the University"));
      text.appendChild(el("p", "desc", "There are no announcements or found items right now."));
      wrap.appendChild(text);
      return wrap;
    }

    var n = s.n;
    var badges = el("div", "badges");
    if (s.kind === "urgent") badges.appendChild(el("span", "badge badge-urgent", "URGENT"));
    else if (s.kind === "found") badges.appendChild(el("span", "badge badge-found", "FOUND ITEM"));
    else badges.appendChild(el("span", "badge badge-notice", "ANNOUNCEMENT"));
    if (n.category) badges.appendChild(el("span", "badge", n.category));
    if (s.kind !== "found" && n.department && n.department !== "All") {
      badges.appendChild(el("span", "badge", n.department));
    }
    text.appendChild(badges);

    text.appendChild(el("h1", "title", n.title));
    if (n.description) text.appendChild(el("p", "desc", n.description));

    var facts = el("div", "facts");
    if (s.kind === "found") {
      if (n.location) facts.appendChild(el("div", "", "📍 " + n.location));
      if (n.date) facts.appendChild(el("div", "", "📅 Found on " + fmtDate(n.date)));
      text.appendChild(facts);
      text.appendChild(el("p", "hint", "Is this yours? Log in to the website and submit a claim."));
    } else {
      facts.appendChild(el("div", "", "📅 Posted " + fmtDate(n.publishDate)));
      if (n.expiryDate) facts.appendChild(el("div", "", "⏳ Until " + fmtDate(n.expiryDate)));
      text.appendChild(facts);
    }
    wrap.appendChild(text);

    if (n.image) {
      var box = el("div", "slide-image");
      var img = document.createElement("img");
      img.src = n.image;
      img.alt = "";
      box.appendChild(img);
      wrap.appendChild(box);
    }
    return wrap;
  }

  function restartProgress() {
    barEl.style.transition = "none";
    barEl.style.width = "0";
    void barEl.offsetWidth; // reflow
    barEl.style.transition = "width " + INTERVAL + "ms linear";
    barEl.style.width = "100%";
  }

  function show(i) {
    if (!slides.length) return;
    idx = (i + slides.length) % slides.length;
    var s = slides[idx];
    var my = ++token;

    slideEl.classList.remove("show");
    setTimeout(function () {
      if (my !== token) return; // a newer slide has taken over
      while (slideEl.firstChild) slideEl.removeChild(slideEl.firstChild);
      slideEl.appendChild(slideContent(s));
      slideEl.classList.add("show");
    }, 350);

    counterEl.textContent = idx + 1 + " / " + slides.length;
    restartProgress();
  }

  function startTimer() {
    clearInterval(timer);
    timer = setInterval(function () { show(idx + 1); }, INTERVAL);
  }

  function go(step) {
    show(idx + step);
    startTimer();
  }

  // ---------- Ticker ----------
  function renderTicker(items) {
    while (trackEl.firstChild) trackEl.removeChild(trackEl.firstChild);
    var list = items.length ? items : [{ title: "No active announcements", urgent: false }];

    function fill(chunk) {
      list.forEach(function (t) {
        chunk.appendChild(el("span", "ticker-item" + (t.urgent ? " urgent" : ""), (t.urgent ? "🔴 " : "• ") + t.title));
      });
    }

    var first = el("div", "ticker-chunk");
    fill(first);
    trackEl.appendChild(first);
    // If the chunk is narrower than the screen, repeat it so there is no gap
    var guard = 0;
    while (first.offsetWidth < windowEl.offsetWidth && guard++ < 10) fill(first);

    trackEl.appendChild(first.cloneNode(true)); // duplicate for a seamless loop
    var seconds = Math.max(first.offsetWidth / 90, 15); // ~90 px/second
    trackEl.style.animation = "none";
    void trackEl.offsetWidth;
    trackEl.style.animation = "ticker " + seconds + "s linear infinite";
  }

  // ---------- Data ----------
  function load() {
    return fetch("/display/data", { cache: "no-store" })
      .then(function (res) {
        if (!res.ok) throw new Error("HTTP " + res.status);
        return res.json();
      })
      .then(function (d) {
        slides = buildSlides(d);
        renderTicker(d.ticker || []);
        if (!started) {
          started = true;
          show(0);
          startTimer();
        } else if (idx >= slides.length) {
          show(0);
        }
      });
  }

  function loadFirst() {
    load().catch(function () {
      if (started) return;
      while (slideEl.firstChild) slideEl.removeChild(slideEl.firstChild);
      slideEl.appendChild(el("div", "loading", "Cannot connect to the server. Retrying…"));
      setTimeout(loadFirst, 10000);
    });
  }

  // ---------- Fullscreen, keyboard, idle cursor ----------
  function toggleFullscreen() {
    var d = document, e = d.documentElement;
    if (!d.fullscreenElement && !d.webkitFullscreenElement) {
      (e.requestFullscreen || e.webkitRequestFullscreen || function () {}).call(e);
    } else {
      (d.exitFullscreen || d.webkitExitFullscreen || function () {}).call(d);
    }
  }
  document.getElementById("fsBtn").addEventListener("click", toggleFullscreen);
  document.addEventListener("keydown", function (e) {
    if (e.key === "f" || e.key === "F") toggleFullscreen();
    else if (e.key === "ArrowRight") go(1);
    else if (e.key === "ArrowLeft") go(-1);
  });

  var idleTimer;
  function wake() {
    document.body.classList.remove("idle");
    clearTimeout(idleTimer);
    idleTimer = setTimeout(function () { document.body.classList.add("idle"); }, 3000);
  }
  document.addEventListener("mousemove", wake);
  wake();

  // ---------- Start ----------
  tick();
  setInterval(tick, 1000);
  loadFirst();
  setInterval(function () { load().catch(function () {}); }, REFRESH);
})();
</script>
</body>
</html>
<% } else { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | University Information Display System</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>">
  <script>
    // Apply the saved theme before the page paints (prevents a flash)
    (function () {
      try {
        var t = localStorage.getItem("theme");
        if (!t) t = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-bs-theme", t);
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark sticky-top site-nav">
  <div class="container">
    <a class="navbar-brand" href="/">
      <span class="brand-mark">📚</span><span class="brand-text">UIDS</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <div class="navbar-nav ms-auto align-items-lg-center">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/notices">Notices</a>
        <a class="nav-link" href="/items">Lost &amp; Found</a>
        <a class="nav-link" href="/display" target="_blank">Display</a>
        <% if (currentUser) { %>
          <a class="nav-link" href="/items/mine">My Reports</a>
          <% if (currentUser.role === "admin") { %>
            <a class="nav-link" href="/admin">Dashboard</a>
          <% } %>
          <span class="nav-link disabled text-white-50">Hi, <%= currentUser.name %></span>
          <a class="nav-link" href="/logout">Logout</a>
        <% } else { %>
          <a class="nav-link" href="/login">Login</a>
          <a class="btn btn-gold btn-sm ms-lg-2 my-1 my-lg-0" href="/signup">Sign up</a>
        <% } %>
        <button id="themeToggle" type="button" class="btn btn-outline-light btn-sm theme-toggle ms-lg-2 my-1 my-lg-0" aria-label="Toggle dark mode">🌙</button>
      </div>
    </div>
  </div>
</nav>
<main class="container py-4">
<% if (typeof flash !== "undefined" && flash) { %>
  <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
    <%= flash.text %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<%# ============ PAGE: index ============ %>
<% if (pageView === "index") { %>
<section class="hero mb-5">
  <div class="hero-seal" aria-hidden="true">🎓</div>
  <div class="hero-inner">
    <span class="hero-kicker">Campus Information Hub</span>
    <h1>University Information Display System</h1>
    <div class="hero-rule"></div>
    <p class="lead">Notices, announcements and lost &amp; found items, all in one place.</p>

    <form method="GET" action="/notices" class="hero-search">
      <input type="text" name="q" class="form-control" placeholder="Search notices...">
      <button class="btn btn-gold px-4">Search</button>
    </form>

    <div class="hero-actions">
      <a class="btn btn-light" href="/notices">View Notices</a>
      <a class="btn btn-outline-light" href="/items">Lost &amp; Found</a>
      <a class="btn btn-outline-light" href="/display" target="_blank">📺 Display Mode</a>
    </div>
  </div>
</section>

<div class="d-flex justify-content-between align-items-end mb-3">
  <h3 class="section-title">Latest Notices</h3>
  <a href="/notices">View all &rarr;</a>
</div>

<% if (notices.length === 0) { %>
  <div class="alert alert-secondary">There are no active notices right now.</div>
<% } %>
<div class="row g-3 mb-5">
  <% notices.forEach(function(n){ %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm <%= n.isPinned ? "border-danger" : "" %>">
        <div class="card-body d-flex flex-column">
          <div class="mb-2">
            <% if (n.isPinned) { %><span class="badge bg-danger">Urgent</span><% } %>
            <span class="badge bg-primary"><%= n.category ? n.category.name : "Uncategorized" %></span>
            <span class="badge bg-secondary"><%= n.department %></span>
          </div>
          <h5 class="card-title"><%= n.title %></h5>
          <p class="card-text text-muted flex-grow-1">
            <%= n.description.length > 100 ? n.description.slice(0, 100) + "..." : n.description %>
          </p>
          <div class="small text-muted mb-2">Posted: <%= fmtDate(n.publishDate) %></div>
          <a href="/notices/<%= n._id %>" class="btn btn-outline-primary btn-sm">Read more</a>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<div class="d-flex justify-content-between align-items-end mb-3">
  <h3 class="section-title">Recently Found</h3>
  <a href="/items?type=found">View all &rarr;</a>
</div>

<% if (found.length === 0) { %>
  <div class="alert alert-secondary">There are no found items right now.</div>
<% } %>
<div class="row g-3 mb-5">
  <% found.forEach(function(it){ %>
    <div class="col-sm-6 col-lg-4">
      <div class="card h-100 shadow-sm">
        <% if (it.image && it.image.filename) { %>
          <img src="/uploads/<%= it.image.filename %>" class="card-img-top" style="height:170px;object-fit:cover;" alt="<%= it.title %>">
        <% } else { %>
          <div class="d-flex align-items-center justify-content-center bg-light text-muted" style="height:170px;font-size:3rem;">📦</div>
        <% } %>
        <div class="card-body d-flex flex-column">
          <div class="mb-2">
            <span class="badge bg-success">FOUND</span>
            <span class="badge bg-primary"><%= it.category ? it.category.name : "Other" %></span>
          </div>
          <h5 class="card-title"><%= it.title %></h5>
          <p class="small text-muted flex-grow-1 mb-2">📍 <%= it.location %> &middot; 📅 <%= fmtDate(it.date) %></p>
          <a href="/items/<%= it._id %>" class="btn btn-outline-primary btn-sm">View details</a>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<h3 class="section-title mb-4">What you can do here</h3>
<div class="row g-3">
  <div class="col-md-4">
    <div class="card h-100 shadow-sm"><div class="card-body">
      <div class="feature-icon">📢</div>
      <h5>Announcements</h5>
