              </form>
              <form method="POST" action="/admin/claims/<%= c._id %>/reject" class="d-inline">
                <button class="btn btn-sm btn-outline-danger">Reject</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<% } %>

<%# ============ PAGE: admin/users ============ %>
<% if (pageView === "admin/users") { %>
