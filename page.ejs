<form method="GET" action="/admin/users" class="row g-2 mb-3" style="max-width:520px;">
  <div class="col">
    <input type="text" name="q" class="form-control" placeholder="Search by name or email..." value="<%= q %>">
  </div>
  <div class="col-auto">
    <button class="btn btn-primary">Search</button>
    <% if (q) { %><a href="/admin/users" class="btn btn-outline-secondary">Reset</a><% } %>
  </div>
</form>

<% if (users.length === 0) { %>
  <div class="alert alert-secondary">No users found.</div>
<% } else { %>
<div class="table-responsive">
  <table class="table align-middle bg-white">
    <thead class="table-light">
      <tr><th>Name</th><th>Email</th><th>Department</th><th>Role</th><th>Joined</th><th></th></tr>
    </thead>
    <tbody>
      <% users.forEach(function(u){
           var isMe = currentUser && String(u._id) === currentUser.id; %>
        <tr>
          <td><%= u.name %> <% if (isMe) { %><span class="badge bg-info text-dark">You</span><% } %></td>
