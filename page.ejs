<%# ============ PAGE: admin/dashboard ============ %>
<% if (pageView === "admin/dashboard") { %>
<h2 class="mb-4">Admin Dashboard</h2>

<% if (stats.pendingItems > 0 || stats.pendingClaims > 0) { %>
  <div class="alert alert-warning">
    <strong>Action needed:</strong>
    <% if (stats.pendingItems > 0) { %>
      <a href="/admin/items?approval=pending"><%= stats.pendingItems %> report(s) awaiting approval</a>
    <% } %>
    <% if (stats.pendingItems > 0 && stats.pendingClaims > 0) { %> &middot; <% } %>
    <% if (stats.pendingClaims > 0) { %>
      <a href="/admin/claims?status=pending"><%= stats.pendingClaims %> claim request(s)</a>
    <% } %>
  </div>
<% } %>

<div class="row g-3 mb-4">
  <%
    var cards = [
      ["Total notices", stats.totalNotices, "primary"],
      ["Active notices", stats.activeNotices, "success"],
      ["Lost items", stats.lostItems, "danger"],
      ["Found items", stats.foundItems, "success"],
      ["Claimed items", stats.claimedItems, "warning"],
      ["Users", stats.totalUsers, "secondary"]
    ];
  %>
  <% cards.forEach(function(c){ %>
    <div class="col-6 col-md-4 col-lg-2">
      <div class="card text-center shadow-sm h-100 border-<%= c[2] %>"><div class="card-body">
        <div class="display-6"><%= c[1] %></div><div class="text-muted small"><%= c[0] %></div>
      </div></div>
    </div>
  <% }) %>
</div>

<div class="row g-3 mb-4">
  <div class="col-lg-6">
    <div class="card shadow-sm h-100"><div class="card-body">
      <h6 class="mb-3">Notices per category</h6>
      <div id="categoryChartBox" style="position:relative;height:300px;">
        <canvas id="categoryChart"></canvas>
      </div>
    </div></div>
  </div>
  <div class="col-lg-6">
    <div class="card shadow-sm h-100"><div class="card-body">
      <h6 class="mb-3">Lost vs Found reports per month</h6>
      <div id="monthlyChartBox" style="position:relative;height:300px;">
        <canvas id="monthlyChart"></canvas>
      </div>
    </div></div>
  </div>
</div>

<div class="d-flex gap-2 flex-wrap">
  <a href="/admin/notices/new" class="btn btn-primary">+ New Notice</a>
  <a href="/admin/notices" class="btn btn-outline-primary">Notices</a>
  <a href="/admin/categories" class="btn btn-outline-primary">Categories</a>
  <a href="/admin/items" class="btn btn-outline-primary">Lost &amp; Found</a>
  <a href="/admin/claims" class="btn btn-outline-primary">Claim Requests</a>
  <a href="/admin/users" class="btn btn-outline-primary">Users</a>
  <a href="/display" target="_blank" class="btn btn-outline-success">📺 Display Mode</a>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
// Dashboard charts: fetches data from /admin/api/stats and draws it with Chart.js
(function () {
  function showMessage(id, text) {
    var box = document.getElementById(id);
    if (box) box.innerHTML = '<div class="text-muted text-center py-5">' + text + "</div>";
  }

  function drawCategoryChart(rows) {
    if (!rows.length) return showMessage("categoryChartBox", "No notices yet.");
    new Chart(document.getElementById("categoryChart"), {
      type: "bar",
      data: {
        labels: rows.map(function (r) { return r.name; }),
        datasets: [{
          label: "Notices",
          data: rows.map(function (r) { return r.count; }),
          backgroundColor: "#0d6efd"
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });
  }

  function drawMonthlyChart(m) {
    var total = m.lost.concat(m.found).reduce(function (a, b) { return a + b; }, 0);
    if (!total) return showMessage("monthlyChartBox", "No approved reports in the last 6 months.");
    new Chart(document.getElementById("monthlyChart"), {
      type: "bar",
      data: {
        labels: m.labels,
        datasets: [
          { label: "Lost", data: m.lost, backgroundColor: "#dc3545" },
          { label: "Found", data: m.found, backgroundColor: "#198754" }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });
  }

  fetch("/admin/api/stats", { headers: { Accept: "application/json" } })
    .then(function (res) {
      if (!res.ok) throw new Error("HTTP " + res.status);
      return res.json();
    })
    .then(function (data) {
      drawCategoryChart(data.noticesPerCategory);
      drawMonthlyChart(data.itemsPerMonth);
    })
    .catch(function () {
      showMessage("categoryChartBox", "Could not load the chart.");
      showMessage("monthlyChartBox", "Could not load the chart.");
    });
})();
</script>
<% } %>

<%# ============ PAGE: admin/notices ============ %>
<% if (pageView === "admin/notices") { %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Manage Notices</h2>
  <a href="/admin/notices/new" class="btn btn-primary">+ New Notice</a>
</div>

<% if (notices.length === 0) { %>
  <div class="alert alert-secondary">No notices yet.</div>
<% } else { %>
<div class="table-responsive">
  <table class="table table-hover align-middle bg-white">
    <thead class="table-light">
      <tr><th>Title</th><th>Category</th><th>Dept</th><th>Publish</th><th>Expiry</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      <% notices.forEach(function(n){
           var expired = n.expiryDate && n.expiryDate <= now;
           var scheduled = n.publishDate > now; %>
        <tr>
          <td>
            <%= n.title %>
            <% if (n.isPinned) { %><span class="badge bg-danger">Urgent</span><% } %>
            <% if (n.attachment && n.attachment.filename) { %>📎<% } %>
          </td>
          <td><%= n.category ? n.category.name : "-" %></td>
          <td><%= n.department %></td>
          <td><%= fmtDate(n.publishDate) %></td>
          <td><%= n.expiryDate ? fmtDate(n.expiryDate) : "-" %></td>
          <td>
            <% if (expired) { %><span class="badge bg-secondary">Expired</span>
            <% } else if (scheduled) { %><span class="badge bg-warning text-dark">Scheduled</span>
            <% } else { %><span class="badge bg-success">Active</span><% } %>
          </td>
          <td class="text-end text-nowrap">
            <a href="/notices/<%= n._id %>" class="btn btn-sm btn-outline-secondary">View</a>
            <a href="/admin/notices/<%= n._id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
            <form method="POST" action="/admin/notices/<%= n._id %>/delete" class="d-inline"
                  onsubmit="return confirm(&#39;Delete this notice?&#39;);">
              <button class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<% } %>

<%# ============ PAGE: admin/notice-form ============ %>
<% if (pageView === "admin/notice-form") { %>
<%
  var v = function(field, fallback) {
    if (old && old[field] !== undefined) return old[field];
    if (notice && notice[field] !== undefined && notice[field] !== null) return notice[field];
    return fallback;
  };
  var catVal = old && old.category !== undefined ? old.category : (notice && notice.category ? String(notice.category) : "");
  var deptVal = v("department", "All");
  var pubVal = old && old.publishDate !== undefined ? old.publishDate : inputDate(notice ? notice.publishDate : new Date());
  var expVal = old && old.expiryDate !== undefined ? old.expiryDate : (notice && notice.expiryDate ? inputDate(notice.expiryDate) : "");
  var pinned = old && Object.keys(old).length ? old.isPinned === "on" : (notice ? notice.isPinned : false);
%>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h3 class="mb-3"><%= notice ? "Edit Notice" : "New Notice" %></h3>

        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

        <% if (categories.length === 0) { %>
          <div class="alert alert-warning">
            Please create a category first. <a href="/admin/categories">Categories page</a>
          </div>
        <% } %>

        <form method="POST" enctype="multipart/form-data"
              action="<%= notice ? "/admin/notices/" + notice._id : "/admin/notices" %>">
          <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" name="title" class="form-control" value="<%= v("title", "") %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" rows="6" class="form-control" required><%= v("description", "") %></textarea>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Category</label>
              <select name="category" class="form-select" required>
                <option value="">-- select --</option>
                <% categories.forEach(function(c){ %>
                  <option value="<%= c._id %>" <%= String(c._id) === catVal ? "selected" : "" %>><%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Department</label>
              <select name="department" class="form-select">
                <% departments.forEach(function(d){ %>
                  <option value="<%= d %>" <%= d === deptVal ? "selected" : "" %>><%= d %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Publish date</label>
              <input type="date" name="publishDate" class="form-control" value="<%= pubVal %>">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Expiry date (optional)</label>
              <input type="date" name="expiryDate" class="form-control" value="<%= expVal %>">
            </div>
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="isPinned" id="isPinned" <%= pinned ? "checked" : "" %>>
            <label class="form-check-label" for="isPinned">Pin / Urgent (shown first, with a red badge)</label>
          </div>
          <div class="mb-3">
            <label class="form-label">Attachment (PDF / JPG / PNG / WEBP, max 5 MB)</label>
            <input type="file" name="attachment" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp">
            <% if (notice && notice.attachment && notice.attachment.filename) { %>
              <div class="form-text">
                Current: <a href="/uploads/<%= notice.attachment.filename %>" target="_blank"><%= notice.attachment.originalName %></a>
                (choosing a new file will replace it)
              </div>
              <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" name="removeAttachment" id="rm">
                <label class="form-check-label" for="rm">Remove current attachment</label>
              </div>
            <% } %>
          </div>
          <button class="btn btn-primary" <%= categories.length === 0 ? "disabled" : "" %>>
            <%= notice ? "Save changes" : "Publish notice" %>
          </button>
          <a href="/admin/notices" class="btn btn-outline-secondary">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>
<% } %>

<%# ============ PAGE: admin/categories ============ %>
<% if (pageView === "admin/categories") { %>
<h2 class="mb-3">Categories</h2>

<form method="POST" action="/admin/categories" class="row g-2 mb-4">
  <div class="col-sm-6 col-md-5">
    <input type="text" name="name" class="form-control" placeholder="New category (e.g. Exams)" required>
