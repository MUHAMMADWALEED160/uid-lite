  </div>
<% } %>

<div class="row g-3">
  <% notices.forEach(function(n){ %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm <%= n.isPinned ? "border-danger" : "" %>">
        <div class="card-body d-flex flex-column">
          <div class="mb-2">
