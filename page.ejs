</form>

<% if (categories.length === 0) { %>
  <div class="alert alert-secondary">No categories yet. Add one above (or run <code>node seed.js</code> in the terminal).</div>
<% } else { %>
<div class="table-responsive">
  <table class="table align-middle bg-white">
    <thead class="table-light"><tr><th>Name</th><th>Type</th><th>Notices</th><th></th></tr></thead>
    <tbody>
      <% categories.forEach(function(c){ %>
        <tr>
          <td>
            <form method="POST" action="/admin/categories/<%= c._id %>/edit" class="d-flex gap-2">
              <input type="text" name="name" class="form-control form-control-sm" value="<%= c.name %>" required>
              <button class="btn btn-sm btn-outline-primary">Save</button>
            </form>
          </td>
          <td><span class="badge bg-secondary"><%= c.type %></span></td>
          <td><%= used[c._id] || 0 %></td>
          <td class="text-end">
            <form method="POST" action="/admin/categories/<%= c._id %>/delete" class="d-inline"
                  onsubmit="return confirm(&#39;Delete this category?&#39;);">
              <button class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<% } %>

<%# ============ PAGE: admin/items ============ %>
<% if (pageView === "admin/items") { %>
<h2 class="mb-3">Manage Lost &amp; Found</h2>

<ul class="nav nav-pills mb-3">
  <li class="nav-item"><a class="nav-link <%= approval === "pending" ? "active" : "" %>" href="/admin/items?approval=pending">Pending (<%= counts.pending %>)</a></li>
  <li class="nav-item"><a class="nav-link <%= approval === "approved" ? "active" : "" %>" href="/admin/items?approval=approved">Approved (<%= counts.approved %>)</a></li>
  <li class="nav-item"><a class="nav-link <%= approval === "rejected" ? "active" : "" %>" href="/admin/items?approval=rejected">Rejected (<%= counts.rejected %>)</a></li>
  <li class="nav-item"><a class="nav-link <%= approval === "all" ? "active" : "" %>" href="/admin/items?approval=all">All</a></li>
</ul>

<% if (items.length === 0) { %>
  <div class="alert alert-secondary">No items in this list.</div>
<% } else { %>
<div class="table-responsive">
  <table class="table table-hover align-middle bg-white">
    <thead class="table-light">
      <tr><th>Title</th><th>Type</th><th>Category</th><th>Posted by</th><th>Date</th><th>Approval</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      <% items.forEach(function(it){ %>
        <tr>
          <td><a href="/items/<%= it._id %>"><%= it.title %></a></td>
          <td><span class="badge bg-<%= it.type === "lost" ? "danger" : "success" %> text-uppercase"><%= it.type %></span></td>
          <td><%= it.category ? it.category.name : "-" %></td>
          <td><%= it.postedBy ? it.postedBy.name : "-" %></td>
          <td><%= fmtDate(it.date) %></td>
          <td><span class="badge bg-<%= it.approval === "approved" ? "success" : it.approval === "rejected" ? "danger" : "warning text-dark" %> text-capitalize"><%= it.approval %></span></td>
          <td>
            <form method="POST" action="/admin/items/<%= it._id %>/status">
              <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <% statuses.forEach(function(s){ %>
                  <option value="<%= s %>" <%= it.status === s ? "selected" : "" %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
                <% }) %>
              </select>
            </form>
          </td>
          <td class="text-end text-nowrap">
            <% if (it.approval !== "approved") { %>
              <form method="POST" action="/admin/items/<%= it._id %>/approve" class="d-inline">
                <button class="btn btn-sm btn-success">Approve</button>
              </form>
            <% } %>
            <% if (it.approval !== "rejected") { %>
              <form method="POST" action="/admin/items/<%= it._id %>/reject" class="d-inline">
                <button class="btn btn-sm btn-outline-warning">Reject</button>
              </form>
            <% } %>
            <form method="POST" action="/admin/items/<%= it._id %>/delete" class="d-inline"
                  onsubmit="return confirm(&#39;Delete this item?&#39;);">
              <button class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<% } %>

