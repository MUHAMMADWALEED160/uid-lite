      <form method="POST" action="/items/<%= item._id %>/claim">
        <textarea name="message" rows="3" class="form-control mb-3" minlength="10" required></textarea>
        <button class="btn btn-success">Send claim request</button>
      </form>
    </div>
  </div>
<% } else if (!currentUser && item.type === "found" && item.status === "found" && item.approval === "approved") { %>
  <div class="alert alert-secondary mt-4">Is this your item? <a href="/login">Log in</a> to submit a claim.</div>
<% } %>
<% } %>

<%# ============ PAGE: items/mine ============ %>
