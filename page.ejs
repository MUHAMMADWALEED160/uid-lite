  <% }) %>
</div>

<% if (totalPages > 1) { %>
  <% var qs = baseQS ? baseQS + "&" : ""; %>
  <nav class="mt-4">
    <ul class="pagination justify-content-center">
      <li class="page-item <%= page <= 1 ? "disabled" : "" %>">
        <a class="page-link" href="/notices?<%= qs %>page=<%= page - 1 %>">Previous</a>
      </li>
      <li class="page-item disabled"><span class="page-link">Page <%= page %> of <%= totalPages %></span></li>
      <li class="page-item <%= page >= totalPages ? "disabled" : "" %>">
        <a class="page-link" href="/notices?<%= qs %>page=<%= page + 1 %>">Next</a>
      </li>
    </ul>
  </nav>
<% } %>
<% } %>

<%# ============ PAGE: notices/detail ============ %>
<% if (pageView === "notices/detail") { %>
<a href="/notices" class="btn btn-link px-0">&larr; Back to notices</a>

<% if (!isActive) { %>
  <div class="alert alert-warning">This notice is not public right now (expired or scheduled). Only admins can see it.</div>
<% } %>

<div class="card shadow-sm">
  <div class="card-body p-4">
    <div class="mb-2">
      <% if (notice.isPinned) { %><span class="badge bg-danger">Urgent</span><% } %>
      <span class="badge bg-primary"><%= notice.category ? notice.category.name : "Uncategorized" %></span>
      <span class="badge bg-secondary"><%= notice.department %></span>
    </div>
