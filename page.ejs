<%# ============ PAGE: items/form ============ %>
<% if (pageView === "items/form") { %>
<%
  var ov = function(f) { return old && old[f] !== undefined ? old[f] : ""; };
  var dateVal = old && old.date ? old.date : inputDate(new Date());
%>
<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h3 class="mb-1"><%= type === "found" ? "Report Found Item" : "Report Lost Item" %></h3>
        <p class="text-muted small">
          Your report will be reviewed by an admin and then made public.
          <% if (type === "lost") { %>
            <a href="/items/new?type=found">Found something? Report a found item.</a>
          <% } else { %>
            <a href="/items/new?type=lost">Lost something? Report a lost item.</a>
          <% } %>
        </p>

        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <% if (categories.length === 0) { %>
          <div class="alert alert-warning">
            There are no item categories yet. Ask an admin, or run <code>node seed.js</code> in the terminal.
          </div>
        <% } %>

        <form method="POST" action="/items" enctype="multipart/form-data">
          <input type="hidden" name="type" value="<%= type %>">

          <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Black wallet" value="<%= ov("title") %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" rows="4" class="form-control" required
              placeholder="Colour, brand, distinguishing marks, what was inside..."><%= ov("description") %></textarea>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Category</label>
              <select name="category" class="form-select" required>
                <option value="">-- select --</option>
                <% categories.forEach(function(c){ %>
                  <option value="<%= c._id %>" <%= String(c._id) === ov("category") ? "selected" : "" %>><%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Date <%= type === "found" ? "found" : "lost" %></label>
              <input type="date" name="date" class="form-control" value="<%= dateVal %>" max="<%= inputDate(new Date()) %>" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Location</label>
            <input type="text" name="location" class="form-control" placeholder="e.g. Library, Block B" value="<%= ov("location") %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Contact info</label>
            <input type="text" name="contactInfo" class="form-control" placeholder="Phone number or email" value="<%= ov("contactInfo") %>" required>
            <div class="form-text">Only logged-in users and admins can see this.</div>
          </div>
          <div class="mb-3">
            <label class="form-label">Photo (optional, max 5 MB)</label>
            <input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png,.webp">
          </div>
          <button class="btn btn-primary" <%= categories.length === 0 ? "disabled" : "" %>>Submit report</button>
          <a href="/items" class="btn btn-outline-secondary">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>
<% } %>

<%# ============ PAGE: items/detail ============ %>
<% if (pageView === "items/detail") { %>
<a href="/items" class="btn btn-link px-0">&larr; Back to Lost &amp; Found</a>

<% if (item.approval === "pending") { %>
  <div class="alert alert-warning">This report is awaiting admin approval. Only you (and admins) can see it.</div>
<% } else if (item.approval === "rejected") { %>
  <div class="alert alert-danger">This report was rejected.</div>
<% } %>

<div class="card shadow-sm">
  <div class="row g-0">
    <% if (item.image && item.image.filename) { %>
      <div class="col-md-5">
        <img src="/uploads/<%= item.image.filename %>" class="img-fluid rounded-start w-100" style="max-height:420px;object-fit:cover;" alt="<%= item.title %>">
      </div>
    <% } %>
    <div class="<%= item.image && item.image.filename ? "col-md-7" : "col-12" %>">
      <div class="card-body p-4">
        <div class="mb-2">
          <span class="badge bg-<%= item.type === "lost" ? "danger" : "success" %> text-uppercase"><%= item.type %></span>
          <span class="badge bg-<%= statusClass(item.status) %> text-capitalize"><%= item.status %></span>
          <span class="badge bg-primary"><%= item.category ? item.category.name : "Other" %></span>
        </div>
        <h2><%= item.title %></h2>
        <p style="white-space: pre-line;"><%= item.description %></p>
        <ul class="list-unstyled text-muted">
          <li>📍 <strong>Location:</strong> <%= item.location %></li>
          <li>📅 <strong>Date:</strong> <%= fmtDate(item.date) %></li>
          <li>👤 <strong>Posted by:</strong> <%= item.postedBy ? item.postedBy.name : "-" %><%= item.postedBy && item.postedBy.department ? " (" + item.postedBy.department + ")" : "" %></li>
        </ul>

        <% if (canSeeContact) { %>
          <div class="alert alert-info py-2">📞 <strong>Contact:</strong> <%= item.contactInfo %></div>
        <% } else if (!currentUser) { %>
          <div class="alert alert-secondary py-2"><a href="/login">Log in</a> to see the contact info.</div>
        <% } else if (item.type === "found") { %>
          <div class="alert alert-secondary py-2">The contact info for a found item is shown after your claim is approved.</div>
        <% } %>

        <% if (myClaim) { %>
          <div class="alert alert-<%= myClaim.status === "approved" ? "success" : myClaim.status === "rejected" ? "danger" : "warning" %>">
            Your claim: <strong class="text-capitalize"><%= myClaim.status %></strong>
          </div>
        <% } %>

        <% if (isOwner || isAdmin) { %>
          <form method="POST" action="/items/<%= item._id %>/delete" class="d-inline"
                onsubmit="return confirm(&#39;Delete this item?&#39;);">
            <button class="btn btn-outline-danger btn-sm">Delete</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<% if (canClaim) { %>
  <div class="card shadow-sm mt-4">
