          <td><span class="badge bg-<%= statusClass(it.status) %> text-capitalize"><%= it.status %></span></td>
          <td>
            <span class="badge bg-<%= it.approval === "approved" ? "success" : it.approval === "rejected" ? "danger" : "warning text-dark" %> text-capitalize"><%= it.approval %></span>
